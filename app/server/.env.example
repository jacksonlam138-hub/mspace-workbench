# M·SPACE 服务端 MCP 适配配置（本文件不含任何密钥，可提交）
# 使用方法：复制为 app/server/.env 或直接在 shell 中 export，再运行 `pnpm mcp:server`。

# 【必填】麦当劳 MCP Token。
# 申请方式：https://open.mcd.cn/mcp → 登录（手机号验证）→ 控制台 → 申请 MCP Token。
# 仅服务端使用，不会进入前端、日志或提交。
MCD_MCP_TOKEN=

# 【可选】MCP 接入地址，默认官方地址 https://mcp.mcd.cn（Streamable HTTP）。
# MCD_MCP_URL=https://mcp.mcd.cn

# 【可选】本地适配服务端口，默认 10243（前端经 Vite 代理 /api/mcp 访问）。
# MCP_ADAPTER_PORT=10243

# 写操作固定拒绝；没有允许下单、领券或抽奖的环境变量开关。

# 可选：OpenAI-compatible 模型，三项都配置后启用模型工具循环。
# BASE_URL 为服务商 API 根地址（例如 https://api.openai.com/v1）。
# DeepSeek 示例：M_AGENT_BASE_URL=https://api.deepseek.com
# 模型名以 https://api-docs.deepseek.com/ 当前列表为准。
# 仅服务端保存；模型服务会收到本次聊天及所调用的工具结果。
M_AGENT_BASE_URL=
M_AGENT_API_KEY=
M_AGENT_MODEL=
